{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thermal Calibration Tool",
  "version": "0.3.0",
  "identifier": "eu.haystackimaging.thermal-calibration",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Thermal Calibration Tool",
        "width": 1500,
        "height": 950,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
