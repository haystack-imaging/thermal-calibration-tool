{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thermal Calibration Tool",
  "version": "0.3.1",
  "identifier": "eu.haystackimaging.thermal-calibration",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Thermal Calibration Tool",
        "width": 1500,
        "height": 950,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Haystack Imaging",
    "copyright": "Copyright 2026 Moritz Nelle",
    "license": "GPL-3.0-only",
    "homepage": "https://github.com/haystack-imaging/thermal-calibration-tool",
    "shortDescription": "Calibrates thermal drone images with reference panels measured in the field",
    "longDescription": "Corrects the drift of uncooled thermal drone cameras with reference targets measured in the field (Empirical Line Method). Built for the DJI Matrice 4T, works with any single-band temperature image.",
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": [
      "resources/"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
